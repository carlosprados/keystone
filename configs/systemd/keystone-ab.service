[Unit]
Description=Keystone Agent (A/B install, self-updating)
After=network-online.target
Wants=network-online.target

# These belong in [Unit]. Put in [Service], systemd accepts StartLimitBurst for
# backwards compatibility and silently DISCARDS StartLimitIntervalSec —
# "Unknown key ... ignoring" — leaving the system default of 10s. Found on a
# real device, because the warning only exists in its journal.
#
# The numbers matter and have to be reasoned against the real window. The gate
# reverts after KEYSTONE_UPDATE_MAX_BOOTS starts, which with RestartSec=3 takes
# about 12 seconds. systemd's limit must stay far above that, because reaching
# it means systemd stops restarting and leaves the unit dead — on a device
# nobody can reach, "stopped trying" is the outcome the whole design avoids.
# 20 starts in 300s leaves the gate an order of magnitude of room.
#
# With the discarded setting the effective window was 10s, which is MORE
# permissive rather than less: at RestartSec=3 only three or four starts fit, so
# a burst of 20 was never reached. It would have bitten with a small or zero
# RestartSec, where 20 starts do fit in 10s and systemd would give up first.
StartLimitBurst=20
StartLimitIntervalSec=300

[Service]
Type=simple

# The leading "-" makes it optional. Without it, a missing file fails the unit
# BEFORE ExecStartPre runs — so the gate would never execute, and a device with
# a pending update would never be rolled back because of a missing config file.
EnvironmentFile=-/etc/keystone/keystone.env

# The pre-start gate decides whether a pending version has had enough chances,
# and rolls back when it has not. It runs before every start, including the
# start that follows a binary which failed to execute — which is the whole
# reason it is a separate script and not part of the agent.
#
# It is deliberately NOT under /opt/keystone/current: it must not be replaced by
# the thing it supervises.
#
# The leading "+" runs it with full privileges, ignoring User= below. That is
# the whole privilege split: /opt/keystone belongs to root, so the agent can
# stage and propose a version but cannot install one, and only this script —
# which the agent never replaces — moves the symlink. Without the "+" the gate
# would run as the unprivileged agent user and fail to roll back, precisely
# when rolling back is the only thing that matters.
ExecStartPre=+/usr/local/lib/keystone/keystone-update-gate.sh

# The agent writes its state under "runtime/", relative to the working
# directory. Without this line systemd starts it in "/", which ProtectSystem=
# strict makes read-only, and the agent cannot even create its own state
# directory. This directory must exist before the unit starts, because it is
# also named in ReadWritePaths below and systemd refuses to build the namespace
# for a path that is not there.
WorkingDirectory=/var/lib/keystone

# Reached through the symlink, resolved afresh at every start. Switching
# versions is a rename of that link.
ExecStart=/opt/keystone/current/keystone --http 127.0.0.1:8080

# Always, not on-failure: an agent that installed a new version exits cleanly
# and expects to be started again into it. With on-failure, a clean exit would
# leave the device with no agent.
Restart=always
RestartSec=3

User=keystone
Group=keystone

# The agent stages and verifies; it does not need to own the binary it runs.
# /opt/keystone is root-owned, and the gate — running as root before the agent
# starts — is what moves the symlink. A compromised agent can therefore propose
# a version but not install one.
ReadWritePaths=/opt/keystone/staging /opt/keystone/state /var/lib/keystone

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
